{
  "name": "gongnori-news-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Newsroom-style multi-agent pipeline for football news (Phase A). See README.md.",
  "scripts": {
    "seed:aliases": "node scripts/seed-aliases.js",
    "agg:scout": "node scripts/agg-scout-run.js",
    "agg:fetch": "node scripts/agg-fetch-run.js",
    "agg:write": "node scripts/agg-write-run.js",
    "agg:publish": "node scripts/agg-publish-run.js",
    "agg:takedown": "node scripts/agg-takedown.js",
    "agg:cycle": "node scripts/agg-scout-run.js && node scripts/agg-fetch-run.js && node scripts/agg-write-run.js",
    "agg:train": "node scripts/agg-train.js",
    "agg:train:gen": "node scripts/agg-train.js gen",
    "agg:train:learn": "node scripts/agg-train.js learn",
    "preview:extract": "node scripts/preview-extract-run.js",
    "preview:publish": "node scripts/preview-publish-run.js"
  },
  "dependencies": {
    "playwright": "^1.57.0",
    "sharp": "^0.34.5"
  }
}
