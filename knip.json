{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "playwright.audit.config.ts",
    "playwright.e2e.config.ts",
    "tests/audit/**/*.spec.ts",
    "tests/e2e/**/*.ts",
    "e2e/**/*.spec.ts",
    "types/**/*.d.ts",
    "lib/stadium/game/scenes/index.ts"
  ],
  "project": [
    "**/*.{ts,tsx}",
    "!**/node_modules/**",
    "!**/.next/**",
    "!**/.audit/**",
    "!**/.playwright-cli/**",
    "!supabase/migrations-backup/**",
    "!data/agents/**",
    "!data/crawlers/**",
    "!aseprite-mcp/**"
  ],
  "ignore": [
    "components/battle/battle-types.ts",
    "lib/supabase/database.types.ts",
    "lib/supabase/types.ts"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "autoprefixer",
    "tw-animate-css",
    "@testing-library/jest-dom",
    "madge",
    "protobufjs"
  ]
}
