{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "playwright.audit.config.ts",
    "playwright.e2e.config.ts",
    "tests/audit/**/*.spec.ts",
    "tests/e2e/**/*.ts",
    "e2e/**/*.spec.ts",
    "types/**/*.d.ts",
    "lib/stadium/game/scenes/index.ts"
  ],
  "project": [
    "**/*.{ts,tsx}",
    "!**/node_modules/**",
    "!**/.next/**",
    "!**/.audit/**",
    "!**/.playwright-cli/**",
    "!supabase/migrations-backup/**",
    "!supabase/functions/**",
    "!data/agents/**",
    "!data/crawlers/**",
    "!aseprite-mcp/**"
  ],
  "ignore": [
    "components/header/gold-balance.tsx",
    "components/season/weekly-draw-reveal.tsx",
    "lib/youtube/resolve-channel.ts",
    "__tests__/_stubs/server-only.ts",
    "supabase/functions/**",
    "components/battle/battle-types.ts",
    "components/battle/create-worldcup-dialog.tsx",
    "components/battle/worldcup-stats.tsx",
    "components/battle/worldcup-view.tsx",
    "components/worldcup/worldcup-page-client.tsx",
    "components/worldcup/worldcup-page.tsx",
    "hooks/use-worldcup.ts",
    "lib/supabase/database.types.ts",
    "lib/supabase/types.ts"
  ],
  "ignoreDependencies": [
    "@tailwindcss/typography",
    "tailwindcss",
    "autoprefixer",
    "tw-animate-css",
    "@testing-library/jest-dom",
    "madge",
    "protobufjs"
  ]
}
