# ============================================
# gongnori.fan Environment Variables
# Copy this file to .env and fill in values
# ============================================

# -- Site --
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# -- Supabase --
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # NEVER expose this to client

# -- Clerk Auth --
# https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# -- Internal API Auth --
# Required for cron jobs and betman sync scripts
# Generate: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# -- Sentry Error Monitoring --
# https://sentry.io → Project Settings
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=sntrys_xxx     # For source map uploads

# -- Optional --
# FACEBOOK_ACCESS_TOKEN=           # Instagram oEmbed API (requires Facebook App + oEmbed Read Advanced Access + App Review)
# NEXT_PUBLIC_APP_URL=             # 베트맨 동기화 스크립트가 호출할 API 베이스. 로컬: http://localhost:3000 / Vultr cron: https://gongnori.fan
# NEXT_PUBLIC_ADSENSE_ID=          # Google AdSense client ID (ca-pub-xxxxx)
# NEXT_PUBLIC_GA_ID=               # Google Analytics 측정 ID (G-XXXXXXXXXX)

# -- LLM 파이프라인 (뉴스 검사관·배정 데스크·요약·인사이트) --
# 미설정 시 각 기능이 스킵/보류로 동작 (자동발행 게이트는 fail-closed)
# OPENAI_API_KEY=sk-xxx
# ADMIN_INSIGHT_MODEL=            # 어드민 인사이트 요약 모델 override

# -- 콘텐츠 자동화 킬스위치 --
# NEWS_AUTO_PUBLISH=on            # 뉴스 자동발행 ("off" = 즉시 정지)
# AGG_AUTO_APPROVE=               # 애그리게이터 자동승인
# SAGA_CARD_ROUTING=              # 발행 기사 → 사가 연동 ("off" = 정지)
# NEWS_ASSIGNMENT_DESK=shadow     # 배정 데스크 (shadow = 관찰만)

# -- 네이버 오픈API (표기 대조·검색) --
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# -- GA4 Data API (weekly-analytics cron) --
# GA4_PROPERTY_ID=
# GA4_SERVICE_ACCOUNT_EMAIL=
# GA4_SERVICE_ACCOUNT_PRIVATE_KEY=

# -- 디스코드 웹훅/봇 --
# DISCORD_OPS_WEBHOOK_URL=        # 운영 알림 (신고/검수/정산/크롤링 이슈)
# DISCORD_EVENT_WEBHOOK_URL=      # 시즌 이벤트 알림 (주간 추첨·듀얼 결과)
# DISCORD_NEWS_WEBHOOK_ARSENAL=
# DISCORD_NEWS_WEBHOOK_LIVERPOOL=
# DISCORD_NEWS_WEBHOOK_CHELSEA=
# DISCORD_NEWS_WEBHOOK_FOOTBALL=
# DISCORD_DIGEST_WEBHOOK_URL=
# DISCORD_DIGEST_MENTION=         # 옵트인 역할만 (예: "<@&123>") — @everyone 금지
# DISCORD_BOT_TOKEN=              # 역할 선택 버튼 인터랙션
# DISCORD_APP_PUBLIC_KEY=

# -- Cloudflare Stream (영상 업로드) --
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
