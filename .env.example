# ============================================
# FanRanker Environment Variables
# Copy this file to .env and fill in values
# ============================================

# -- Site --
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# -- Supabase --
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # NEVER expose this to client

# -- Clerk Auth --
# https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# -- Internal API Auth --
# Required for cron jobs and betman sync scripts
# Generate: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# -- Sentry Error Monitoring --
# https://sentry.io → Project Settings
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=sntrys_xxx     # For source map uploads

# -- Optional --
# FACEBOOK_ACCESS_TOKEN=           # Facebook oEmbed API
# NEXT_PUBLIC_APP_URL=             # Override app URL for scripts
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=   # Google AdSense
# NEXT_PUBLIC_ADSENSE_SLOT_ID=     # Google AdSense slot
